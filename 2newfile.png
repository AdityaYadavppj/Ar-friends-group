<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sports Scorecard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        .container {
            width: 800px;
            margin: auto;
            border: 1px solid #000;
            padding: 20px;
        }
        h1, h2 {
            text-align: center;
        }
        .header, .footer {
            display: flex;
            justify-content: space-between;
        }
        .form-info, .score-table {
            margin-top: 20px;
        }
        .form-info input, .footer input {
            width: 300px;
            padding: 5px;
            margin: 5px 0;
        }
        .player-info {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .player-details {
            width: 60%;
        }
        .player-pic {
            width: 30%;
            text-align: right;
        }
        .player-pic img {
            border: 1px solid #000;
            width: 150px;
            height: 150px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 10px;
            text-align: center;
        }
        .footer {
            margin-top: 20px;
            align-items: center;
        }
        .footer div {
            width: 200px;
        }
        .barcode {
            text-align: center;
            margin: 20px 0;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Sports of Our Campus</h1>

    <div class="header">
        <div>
            <p>Form No: <input type="text" placeholder="Form No"></p>
            <p>Position: <input type="text" placeholder="Position"></p>
        </div>
        <div>
            <!-- Company Logo Section -->
            <img src="company-logo.png" alt="Company Logo" style="width: 100px; height: auto;">
        </div>
        <div>
            <p>Serial No: <input type="text" placeholder="Serial No"></p>
            <p>Registration No: <input type="text" placeholder="Registration No"></p>
        </div>
    </div>

    <h2>(Score Intimation) My Heading</h2>
    <h2>Group Pre-Finals</h2>

    <div class="player-info">
        <div class="player-details">
            <p>Name: <input type="text" placeholder="Name"></p>
            <p>Father's Name: <input type="text" placeholder="Father's Name"></p>
            <p>Division: <input type="text" placeholder="Division"></p>
        </div>
        <div class="player-pic">
            <!-- Player Picture -->
            <img src="player-pic-placeholder.png" alt="Player Picture">
        </div>
    </div>

    <div class="score-table">
        <h2>Table of Score</h2>
        <table>
            <tr>
                <th>Round</th>
                <th>Score</th>
                <th>Remarks</th>
            </tr>
            <tr>
                <td>1</td>
                <td><input type="text" placeholder="Score"></td>
                <td><input type="text" placeholder="Remarks"></td>
            </tr>
            <tr>
                <td>2</td>
                <td><input type="text" placeholder="Score"></td>
                <td><input type="text" placeholder="Remarks"></td>
            </tr>
            <tr>
                <td>3</td>
                <td><input type="text" placeholder="Score"></td>
                <td><input type="text" placeholder="Remarks"></td>
            </tr>
        </table>
    </div>

    <div class="footer">
        <div>
            <p>Prepared by: <input type="text" placeholder="Prepared by"></p>
            <p>Checked by: <input type="text" placeholder="Checked by"></p>
        </div>
        <div class="barcode">
            <p>Barcode</p>
            <div style="border: 1px solid #000; padding: 10px;">
                ||||||||||||||||||
            </div>
        </div>
        <div>
            <p>Date: <input type="text" placeholder="Date"></p>
            <p>Signature: _____________________</p>
        </div>
    </div>

</div>

</body>
</html>